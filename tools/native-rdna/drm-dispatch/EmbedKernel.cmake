file(READ "${INPUT}" content HEX)
string(LENGTH "${content}" length)
math(EXPR remainder "${length} % 8")
if(NOT remainder EQUAL 0 OR length EQUAL 0)
    message(FATAL_ERROR "${INPUT} is not a whole number of dwords")
endif()
set(words "")
math(EXPR last "${length} - 8")
foreach(offset RANGE 0 ${last} 8)
    string(SUBSTRING "${content}" ${offset} 8 word)
    string(SUBSTRING "${word}" 6 2 b3)
    string(SUBSTRING "${word}" 4 2 b2)
    string(SUBSTRING "${word}" 2 2 b1)
    string(SUBSTRING "${word}" 0 2 b0)
    string(APPEND words "    0x${b3}${b2}${b1}${b0}u,\n")
endforeach()
file(WRITE "${OUTPUT}" "#ifndef TOOLS_NATIVE_RDNA_DRM_DISPATCH_KERNELBINARY_HPP\n#define TOOLS_NATIVE_RDNA_DRM_DISPATCH_KERNELBINARY_HPP\n\n#include <array>\n#include <cstdint>\n\ninline constexpr std::array KernelBinary = {\n${words}};\n\n#endif\n")
